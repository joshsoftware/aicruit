# Google and GCP Keys (if applicable)
GOOGLE_ACCOUNT_FILE=xxxxxxxxxxxxxxxxxxxx
GCP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SERVICE_ACCOUNT_FILE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (for LLM fallback if not using local models)
OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local ML Model configs
MODEL_ID='base'
MODEL_PATH='./models'
LLM_MODEL=llama3.2
OLLAMA_HOST=http://host.docker.internal:11434

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/aicruit_development
DATABASE_NAME=aicruit_development
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# AWS S3 Settings for resume storage
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION="us-east-1"

# Rails Backend Communication Settings
RAILS_API_TOKEN=dummy_python_api_key
# Must match the API versioning Accept header of Rails (application/vnd.aicruit.com; version=1)
RAILS_ACCEPT_HEADER=application/vnd.aicruit.com; version=1
RAILS_API_BASE_URL=http://api:3000

# Other API paths
API_URL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx